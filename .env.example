# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Maps JavaScript API key, restricted to your site's HTTP referrer. Renders
# the live map tiles in Nearby Help. Get one at console.cloud.google.com.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Backend only — never add a VITE_ prefix
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Groq Whisper transcribes voice, then translates non-English speech for review.
GROQ_API_KEY=
# Optional text fallback, backend only. Never use a VITE_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Set true only after checking billing + the provider data-processing terms.
GEMINI_SENSITIVE_PROCESSING_ENABLED=false
# Places API (New) key, IP-restricted (no HTTP referrer restriction, since
# this call is server-side). Powers real hospital/clinic/pharmacy/petrol/
# restaurant search in Nearby Help. Can be the same Google Cloud project as
# VITE_GOOGLE_MAPS_BROWSER_KEY above, but as a separate, differently
# restricted key.
GOOGLE_MAPS_SERVER_KEY=
# Temporary: while no Places key exists, Nearby serves labelled Munnar sample
# points instead of a provider. Set false the moment a real key is configured.
PLACES_DEMO_ENABLED=false
SUPABASE_SECRET_KEY=
# Backend may use these rather than browser-prefixed equivalents.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:5173
AI_DAILY_LIMIT=30
AUDIO_DAILY_LIMIT=10
PLACES_DAILY_LIMIT=20
# Configure SMTP inside Supabase, not in browser code.
