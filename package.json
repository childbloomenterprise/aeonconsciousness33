{
  "name": "linc-33",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/finalize-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b",
    "check:server": "tsc -p api/tsconfig.json --outDir .local/server-build --rootDir . && node scripts/check-runtime.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:secrets": "node scripts/check-bundle.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "format": "prettier --write src shared server api scripts tests *.json *.ts public/sw.js",
    "format:check": "prettier --check src shared server api scripts tests *.json *.ts public/sw.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "latest",
    "@radix-ui/react-dialog": "latest",
    "@supabase/supabase-js": "latest",
    "@tailwindcss/vite": "latest",
    "@tanstack/react-query": "latest",
    "@types/node": "^26.6.5",
    "clsx": "latest",
    "date-fns": "latest",
    "lucide-react": "latest",
    "motion": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
